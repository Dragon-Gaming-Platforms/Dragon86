#!/usr/bin/ash
# Dragon86 v86 guest init.
#
# The guest's root filesystem is *not* in this initramfs. It is ZenFS
# (/home/user/v86 on the OS side), served to the kernel as a 9p share by
# src/bridge/p9.ts. This script brings up the buses and the console, mounts
# that share at /newroot, and switches into it, so from then on every file the
# distro reads or runs is an ordinary file in Dragon86 — visible in Files,
# editable there, writable from inside the guest.
#
# The initramfs still has to exist: it is what the kernel is given, and it
# holds the modules needed to reach the 9p device. If the share does not
# arrive (host still unpacking on a first boot), we fall back to a shell in
# this initramfs so the user sees a prompt instead of a dead console.
export PATH=/usr/bin:/usr/sbin
mount -t proc -o noexec,nosuid,nodev proc /proc 2>/dev/null
mount -t sysfs -o noexec,nosuid,nodev sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /shared /mnt /newroot /run
mount -t devpts devpts /dev/pts 2>/dev/null

# serial line size arrives on the kernel cmdline (d86cols/d86rows) —
# serial has no winsize channel, so the host tells us up front, in-band.
COLS=80; ROWS=24
for p in $(cat /proc/cmdline); do
  case "$p" in
    d86cols=*) COLS="${p#d86cols=}" ;;
    d86rows=*) ROWS="${p#d86rows=}" ;;
  esac
done
stty -F /dev/ttyS0 rows "$ROWS" cols "$COLS" 2>/dev/null

# The machine's screen (console=tty0 on the cmdline) is the VGA text console —
# it is what the Engine Viewer window mirrors. The shell lives on the serial
# line below, but the *screen* gets the boot story a few lines at a time:
# without this it shows BIOS output and then nothing but the last kernel
# message, which looks like a broken viewer.
# Absent tty0 (a container, a harness without a screen) → silently skipped.
vga() {
  [ -w /dev/tty0 ] || return 0
  printf '%s\n' "$@" >/dev/tty0 2>/dev/null
}

vga "" \
    "  Dragon86 Linux (v86 engine)" \
    "  ----------------------------" \
    "  This is the machine's VGA screen - the Engine Viewer shows it." \
    "  The shell is on the serial console: open a Terminal." \
    "" \
    "  [ 1/4 ] initramfs up; mounting Dragon86 filesystem..."

# Talk to the serial line directly from here on. init's stdout is /dev/console,
# which the kernel mirrors onto the boot console as well — the same tty twice —
# so every line would be printed twice on screen.
exec >/dev/ttyS0 2>&1

# Loopback is not the emulator's business and nothing else brings it up: without
# this, 127.0.0.1 is "network unreachable" and anything that talks to itself
# (a local server, a test, `git clone http://127.0.0.1:…`) fails.
ip link set lo up 2>/dev/null

modprobe virtio_pci_legacy_dev 2>/dev/null
modprobe virtio_pci_modern_dev 2>/dev/null
modprobe virtio_pci
modprobe 9pnet_virtio
modprobe 9p 2>/dev/null

# Networking. The card is emulated by v86 (virtio-net by default), and v86
# answers DHCP itself for its local link, so bringing it up here is all the
# guest needs to do — same job as networking.sh in copy.sh's images,
# which ships in this root filesystem for exactly that reason. It runs in the
# background so a missing relay can never delay the shell.
cat > /etc/udhcpc.script <<'EOF'
#!/bin/sh
case "$1" in
  deconfig)
    ip addr flush dev "$interface" 2>/dev/null
    ip link set "$interface" up 2>/dev/null
    ;;
  renew|bound)
    ip addr flush dev "$interface" 2>/dev/null
    ip addr add "$ip/$mask" dev "$interface" 2>/dev/null
    ip link set "$interface" up 2>/dev/null
    [ -n "${router:-}" ] && ip route replace default via "$router" 2>/dev/null
    { for ns in ${dns:-}; do echo "nameserver $ns"; done; } > /etc/resolv.conf
    [ -s /etc/resolv.conf ] || echo "nameserver 192.168.86.1" > /etc/resolv.conf
    ;;
esac
exit 0
EOF
chmod +x /etc/udhcpc.script

(
  for i in $(seq 1 60); do
    [ -e /sys/class/net/eth0 ] && break
    modprobe virtio_net 2>/dev/null
    modprobe ne2k_pci 2>/dev/null
    sleep 1
  done
  [ -e /sys/class/net/eth0 ] || exit 0
  ip link set eth0 up 2>/dev/null
  udhcpc -i eth0 -s /etc/udhcpc.script -q -n -t 6 -T 3 2>/dev/null
) &

# The virtio PCI probe finishes well after init starts under emulation, and
# mounting before the device exists burns the single 9p channel on a doomed
# client. Wait for the device, then mount the OS filesystem as the root.
(
  for i in $(seq 1 150); do
    [ -e /sys/bus/virtio/devices/virtio0 ] && break
    sleep 0.2
  done
) 
# Mount the share once. The caller reaches this twice (once to repair a lost
# mode bit, once before the session), so an already-mounted /newroot counts as
# success instead of being mounted again: a second mount of the same tag is
# refused with EBUSY, and every refusal also makes 9pnet_virtio log "no
# channels available" — which is how one successful mount used to turn into a
# storm of those messages and a recovery shell.
MOUNT_ROOT_ERR=
mount_root() {
  mountpoint -q /newroot && return 0
  for i in $(seq 1 40); do
    # Keep mount's own message: when this fails it is the only description of
    # why (no device, wrong tag, backend refused the client), and it used to be
    # thrown away here.
    MOUNT_ROOT_ERR=$(mount -t 9p -o trans=virtio,version=9p2000.L,cache=loose,msize=1048576 host9p /newroot 2>&1)
    if [ $? -eq 0 ]; then
      return 0
    fi
    # A refused mount can leave the transport holding a channel that will never
    # be used again; reloading it gives the next attempt a clean one.
    rmmod 9pnet_virtio 2>/dev/null
    modprobe 9pnet_virtio 2>/dev/null
    mountpoint -q /newroot && return 0
    sleep 1
  done
  return 1
}

# The kernel's own filesystems follow the 9p root in by bind mount (a 9p root
# cannot be pivot_root'ed into, and switch_root's MS_MOVE fails on it), and
# /tmp and /run want to be scratch space rather than files on the "disk".
setup_mounts() {
  mkdir -p /newroot/proc /newroot/sys /newroot/dev /newroot/tmp /newroot/run /newroot/root
  mount --bind /proc /newroot/proc 2>/dev/null
  mount --bind /sys /newroot/sys 2>/dev/null
  mount --bind /dev /newroot/dev 2>/dev/null
  mount -t tmpfs tmpfs /newroot/tmp 2>/dev/null
  mount -t tmpfs tmpfs /newroot/run 2>/dev/null
}

teardown_mounts() {
  umount /newroot/proc /newroot/sys /newroot/dev /newroot/tmp /newroot/run 2>/dev/null
  umount /newroot 2>/dev/null
}

run_session() {
  # No launcher script: bash itself is the entry point, so nothing on the
  # share has to be written, chmod'ed or executed for a shell to appear.
  # setsid -c makes bash a session leader with ttyS0 as its controlling
  # terminal (job control, Ctrl-C); without setsid we still get a shell.
  HOME=/root
  TERM=xterm-256color
  export HOME TERM
  # Never depend on the executable bit of a file on the share: bash is
  # invoked *by* the kernel's chroot helper, and it is a real ELF that the
  # unpack gave 0755. The distro's own scripts are run through it, not
  # exec'd, so a lost bit on one of those cannot lock anyone out.
  if [ -x /newroot/usr/bin/setsid ]; then
    chroot /newroot /usr/bin/setsid -c /usr/bin/bash -l </dev/ttyS0 >/dev/ttyS0 2>&1
  else
    chroot /newroot /usr/bin/bash -l </dev/ttyS0 >/dev/ttyS0 2>&1
  fi
}

vga "  [ 2/4 ] waiting for the 9p share (/home/user/v86)..."

if mount_root; then
  # A distro unpacked by an older build can have lost its permission bits
  # (a 9p write lands 0644, and a chmod during unpack that the backend
  # dropped leaves it that way). Then bash exists but cannot be executed —
  # exactly the "Permission denied" loop. Fix it here, through the mount we
  # just made, and say plainly if it will not take.
  if [ ! -x /newroot/usr/bin/bash ] && [ -f /newroot/usr/bin/bash ]; then
    chmod 755 /newroot/usr/bin/bash 2>/dev/null
    echo "  note: /usr/bin/bash was not executable; tried to fix its mode."
  fi
fi

if mount_root && [ -x /newroot/usr/bin/bash ]; then
  vga "  [ 3/4 ] share mounted; starting the shell on the serial line..."

# ---------------------------------------------------------------------------
# The machine's screen (console=tty0 → the VGA display the Engine Viewer
# mirrors). With the shell on the serial line, the VGA would otherwise show
# the last kernel message and then nothing at all, which looks like a broken
# viewer. So the screen gets a live console panel instead: who this machine
# is, what it is doing, and what was last typed into it. Refreshed every few
# seconds; the kernel's own log lines can still appear, and the next repaint
# tidies them away.
#
# Colours are the console's 16, not truecolour: this is a VGA text screen.
# Nothing here reads from tty0 — the keyboard belongs to the Terminal.
# ---------------------------------------------------------------------------
if [ -w /dev/tty0 ]; then
  # One key/value line from /proc, for the memory and load readouts.
  proc_field() {
    awk -v k="$1" '$1 == k ":" { print $2; exit }' "/proc/$2" 2>/dev/null
  }

  human_mb() {
    # kB → "24 MB" (this machine is small; MB is the only unit that matters).
    echo "$((${1:-0} / 1024)) MB"
  }

  guest_uptime() {
    up=$(cut -d' ' -f1 /proc/uptime 2>/dev/null | cut -d. -f1)
    up=${up:-0}
    printf '%dm %02ds' "$((up / 60))" "$((up % 60))"
  }

  guest_ip() {
    ip -4 -o addr show eth0 2>/dev/null | awk '{ print $4; exit }'
  }

  recent_commands() {
    # The shell runs in the distro at /newroot; its history is the best
    # description of what the person at the Terminal is doing.
    hist=/newroot/root/.bash_history
    [ -r "$hist" ] || return 0
    tail -n 6 "$hist" 2>/dev/null | sed 's/^/    $ /'
  }

  panel() {
    [ -w /dev/tty0 ] || return 0
    mem_total=$(proc_field MemTotal meminfo)
    mem_free=$(proc_field MemFree meminfo)
    used=$(( (${mem_total:-0} - ${mem_free:-0}) ))
    set -- $(cut -d' ' -f1 /proc/loadavg 2>/dev/null)
    load=${1:-0.00}
    {
      printf '\033[H\033[2J'
      printf '\033[1;36m  Dragon86 Linux (v86 engine)\033[0m\033[36m%s\033[0m\n' \
        "                       Arch userland"
      printf '\033[34m  ------------------------------------------------------------------------------\033[0m\n'
      printf '\033[37m  This is the machine'"'"'s screen.\033[0m  \033[33mType into the Terminal.\033[0m\n\n'
      printf '\033[36m  Up\033[0m        %s   \033[36mLoad\033[0m %s\n' "$(guest_uptime)" "$load"
      printf '\033[36m  Memory\033[0m    %s used of %s   \033[36mFree\033[0m %s\n' \
        "$(human_mb "$used")" "$(human_mb "${mem_total:-0}")" "$(human_mb "${mem_free:-0}")"
      printf '\033[36m  Root\033[0m      %s\n' "$(awk '$2 == "/newroot" { print "the v86/ folder in Dragon86 (" $3 ", read-write)"; exit }' /proc/mounts 2>/dev/null || echo "not mounted")"
      addr=$(guest_ip)
      [ -n "$addr" ] || addr="no lease yet - the card retries /networking.sh at boot"
      printf '\033[36m  Network\033[0m   %s\n' "$addr"
      printf '\033[34m  ------------------------------------------------------------------------------\033[0m\n'
      printf '\033[36m  Last typed in the Terminal\033[0m\n'
      tail_out=$(recent_commands)
      [ -n "$tail_out" ] && printf '%s\n' "$tail_out"
      [ -n "$tail_out" ] || printf '\033[2m    nothing yet\033[0m\n'
      printf '\n\033[2m  Read-only mirror of the machine; it repaints every 5 seconds.\033[0m\n'
    } >/dev/tty0 2>/dev/null
  }

  # Repaint until the share goes away (a crashed session tears the mount down).
  (
    while mountpoint -q /newroot 2>/dev/null; do
      panel
      sleep 5
    done
    panel >/dev/null 2>&1
  ) &
fi


  vga "  [ 4/4 ] ready." "" \
      "  Shell: the Terminal window.  Files: Files > v86." \
      "  This screen is read-only here; keep it open to watch the machine."
  clear 2>/dev/null
  echo ""
  echo "  Dragon86 Linux (v86 · Arch userland) — compatibility engine"
  echo "  ----------------------------------------------------------"
  echo "  / is your Dragon86 filesystem (v86/ in Files) — edit it there."
  echo "  /Documents, /Downloads and /Desktop are the ones in Files."
  echo "  /system/apps holds the OS's filesystem apps. Network: /networking.sh"
  echo ""
  # A shell that dies on its own (rather than exiting) leaves us here. Give
  # it a few tries, and if it dies almost immediately assume the share is
  # stale — a rebuilt root or a re-opened Terminal window can hand the guest
  # inodes whose fids no longer mean anything, and the fix for that is a
  # fresh 9p mount, not another chroot into the same one.
  try=1
  while [ "$try" -le 4 ]; do
    setup_mounts
    started=$(cut -d' ' -f1 /proc/uptime)
    run_session
    status=$?
    ended=$(cut -d' ' -f1 /proc/uptime)
    echo ""
    echo "  Session ended (status $status). Respawning in 2s — Ctrl-C to stay in the initramfs."
    sleep 2
    # `cut` gives fractional seconds; a session that lasted under 5s is a
    # crash, not an exit, so start over with a new mount.
    lived=$(awk -v a="$started" -v b="$ended" 'BEGIN{printf "%d", b-a}')
    try=$((try + 1))
    if [ "${lived:-0}" -lt 5 ]; then
      teardown_mounts
      mount_root || break
    fi
  done
  echo "  The guest shell keeps exiting at once; dropping to the initramfs recovery shell."
  echo ""
fi

# Fallback: no 9p root (first boot is still unpacking, or the host has none).
# Run from this initramfs and mount /shared if it ever arrives.
(
  for i in $(seq 1 10); do
    mountpoint -q /newroot 2>/dev/null && exit 0
    mount -t 9p -o trans=virtio,version=9p2000.L,cache=loose,msize=1048576 host9p /newroot 2>/dev/null && exit 0
    sleep 2
  done
) &
vga "" \
    "  [ ! ] the Dragon86 filesystem (/home/user/v86) is not serving." \
    "        Recovery shell on the serial line; the Terminal says why."

export HOME=/root
export TERM=xterm-256color
clear 2>/dev/null
echo ""
echo "  Dragon86 Linux (v86 · Arch userland) — recovery shell"
echo "  ----------------------------------------------------"
echo "  The distro root is not serving, so this is the fallback shell."
[ -n "$MOUNT_ROOT_ERR" ] && echo "  mount said: $MOUNT_ROOT_ERR"
echo "  Reconnect from the Terminal to try again."
echo ""
cd /
while true; do
  setsid -c /usr/bin/bash -l </dev/ttyS0 >/dev/ttyS0 2>&1
  sleep 1
done
