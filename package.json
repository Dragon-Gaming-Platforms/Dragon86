{
  "name": "dragon86",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dragon86 — a web OS by Dragon Gaming Platforms",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test:unit": "node tools/run-unit-tests.mjs",
    "build:vm": "vite build --config tools/vm/vite.config.ts",
    "build:app": "vite build",
    "build": "npm run typecheck && npm run test:unit && npm run build:vm && node tools/test-p9-symlink.mjs && npm run build:app",
    "preview": "vite preview",
    "test:ui": "vite build --config tools/ui-smoke/vite.config.ts && node --experimental-strip-types tools/ui-smoke/run.mjs",
    "test:guest": "node tools/test-guest-scripts.mjs",
    "test:preview": "node tools/test-preview.mjs",
    "test:archive": "node --experimental-strip-types tools/test-archive.mjs",
    "test:download": "node --experimental-strip-types tools/test-download.mjs",
    "test:fs-export": "node --experimental-strip-types tools/test-fs-export.mjs",
    "test:fs-import": "node --experimental-strip-types tools/test-fs-import.mjs",
    "test:p9": "vite build --config tools/vm/vite.config.ts && node tools/test-p9-symlink.mjs",
    "test:vm": "vite build --config tools/vm/vite.config.ts && node --experimental-strip-types tools/vm/boot.mjs",
    "test:vm:rv64": "vite build --config tools/vm/vite.config.ts && node tools/vm/boot-rv64.mjs",
    "test:fs-access": "node --experimental-strip-types tools/test-fs-access.mjs",
    "test:all": "npm run build && npm run test:ui"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@zenfs/core": "^2.7.7",
    "@zenfs/dom": "^1.2.14",
    "fzstd": "^0.1.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "jsdom": "^30.1.3",
    "fake-indexeddb": "^6.2.2"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
