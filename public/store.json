  "name": "Dragon86 App Store",
  "apps": [
    {
      "id": "arch-linux",
      "name": "Arch Linux (x86)",
      "sub": "The operating system the Terminal's machines boot",
      "category": "System",
      "publisher": "Arch Linux 32 userland · Dragon86 build",
      "icon": "linux",
      "base": "v86/",
      "files": [
        "initrd.gz",
        "bzImage"
      ],
      "description": "A real Arch Linux userland (bash, coreutils, git, kernel modules) for the x86 machines in the Terminal. Installing unpacks it into your filesystem's own / — every file of the distro becomes a normal file in Files, and the machine boots it from there over 9p. Nothing boots until this is installed: the Terminal will tell you to come here first. Uninstalling is not offered because the distro's files are woven into /; Settings → Machine can re-unpack it if it breaks."
    },
    {
      "id": "arch-linux-64",
      "name": "Arch Linux (x86-64)",
      "sub": "Arch's own 64-bit build, for the x86-64 machine",
      "category": "System",
      "publisher": "Arch Linux x86_64 · Dragon86 build",
      "icon": "linux",
      "base": "arch64/",
      "files": [
        "initrd.gz",
        "bzImage"
      ],
      "description": "Arch Linux as Arch builds it for real 64-bit machines: the linux-lts kernel, 64-bit bash, coreutils and glibc straight from Arch's packages, and a static 64-bit git with networking and HTTPS git clone — the same tooling as the x86 build, compiled for x86_64. It needs the x86-64 machine (Settings → Machine); a 32-bit CPU cannot run it, here or anywhere. The two Arch entries share your filesystem's /, so installing this one replaces the installed (x86) userland in place — your own files stay."
    },
    {
      "id": "alpine-linux-riscv64",
      "name": "Alpine Linux (RISC-V 64)",
      "sub": "Official Alpine riscv64, for the RISC-V 64 machine",
      "category": "System",
      "publisher": "Alpine Linux riscv64 · Dragon86 build",
      "icon": "linux",
      "base": "rv64/",
      "files": [
        "initrd.gz",
        "Image"
      ],
      "description": "Alpine Linux as Alpine builds it for real RISC-V 64 hardware: busybox, musl, bash and Alpine's own git — a full build with working HTTPS, so git clone https://… runs natively, no helper needed. Networking comes up by itself through the emulator's fetch backend. It needs the RISC-V 64 machine (Settings → Machine); an x86 CPU cannot run it, here or anywhere. The distros share your filesystem's /, so installing this one replaces the installed Arch userland in place — your own files stay. This machine has no display: the Terminal's serial console is its console."
    },
    {
      "id": "netbsd-arm64",
      "name": "NetBSD (ARM64)",
      "sub": "Official NetBSD 11.0, for the ARM64 machine",
      "category": "System",
      "publisher": "The NetBSD Foundation · official release",
      "icon": "terminal",
      "base": "netbsd64/",
      "description": "NetBSD as the NetBSD Foundation builds it for real ARM64 hardware: the official 11.0 evbarm-aarch64 release, trimmed of its X11 sets and manual pages so it fits a browser download, and boot-tested before it ships. Unlike the Linux distros it does not unpack into your filesystem's /: NetBSD boots from its own disk image in browser storage (OPFS), and its files live inside that image, in NetBSD's own FFS filesystem — Files cannot see them, and exporting your filesystem does not include them. It needs the ARM64 machine (Settings → Machine). Serial console only for now: log in as root (no password), shut down with shutdown -p now. No network on this machine yet — honestly, not “coming right up”."
    },
    {
      "id": "x11-wm-64",
      "name": "install-wm64.sh",
      "sub": "X11 + IceWM — a window manager on the machine's display",
      "category": "System",
      "publisher": "Arch Linux x86_64 packages · Dragon86 pack",
      "icon": "desktop",
      "base": "arch64-x11/",
      "description": "A real X11 desktop for the x86-64 machine: Xorg on the machine's own display (open the Engine Viewer to see it), the IceWM window manager, and xterm — Arch's own packages, with the bochs display and evdev input kernel modules to match the installed kernel. Installing dumps /install-wm64.sh and its payload into your filesystem; the second half runs inside the machine: sh /install-wm64.sh, then startwm. Mouse and keyboard work on the Engine Viewer screen. Needs Arch Linux (x86-64) installed and the x86_64 machine selected."
    },
    {
      "id": "netsurf-64",
      "name": "install-netsurf.sh",
      "sub": "NetSurf — a real graphical web browser, in the window manager",
      "category": "System",
      "publisher": "Arch Linux x86_64 packages · Dragon86 pack",
      "icon": "browser",
      "base": "arch64-netsurf/",
      "description": "NetSurf is a real browser engine — its own layout, CSS and image rendering — built to be light enough for exactly this kind of machine. (Chromium itself cannot run here: it needs a gigabyte of RAM and a GPU, and this is a software-emulated x86-64 with 256 MB — an install script would only pretend.) Installing dumps /install-netsurf.sh and its payload into your filesystem; inside the machine run sh /install-netsurf.sh, then start NetSurf from the IceWM menu on the Engine Viewer screen. Needs install-wm64.sh set up first, and /networking.sh for the network."
    },
