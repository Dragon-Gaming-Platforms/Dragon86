prefix=/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libbluray
Description: library supporting Blu-ray playback
Version: 1.3.0
Libs: -L${libdir} -lbluray
Libs.private: -ldl  -lpthread
Requires.private:  libxml-2.0 >= 2.6 freetype2 fontconfig
Cflags: -I${includedir}
