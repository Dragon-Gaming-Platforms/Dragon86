  <configure name="FEATURES" value="DPC HDRI Cipher OpenCL OpenMP Modules"/>
  <configure name="FILTER_PATH" value="/usr/lib/ImageMagick-7.1.0/modules-Q16HDRI/filters"/>
  <configure name="GIT_REVISION" value="20319" />
  <configure name="HOST" value="i686-pc-linux-gnu"/>
