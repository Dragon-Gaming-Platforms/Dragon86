  <configure name="CPPFLAGS" value="-I/usr/include/ImageMagick-7"/>
  <configure name="CXXFLAGS" value="-march=pentium4 -mtune=generic -O2 -pipe -fno-plt -fexceptions         -Wp,-D_FORTIFY_SOURCE=2 -Wformat -Werror=format-security         -fstack-clash-protection  -Wp,-D_GLIBCXX_ASSERTIONS -g -ffile-prefix-map=/build/imagemagick/src=/usr/src/debug -flto=auto -pthread"/>
  <configure name="CXX" value="g++"/>
  <configure name="DEFS" value="-DHAVE_CONFIG_H"/>
  <configure name="DELEGATES" value="bzlib djvu fontconfig freetype heic jbig jng jpeg jxl lcms lqr lzma openexr openjp2 pango png ps raqm raw rsvg tiff webp wmf x xml zip zlib zstd"/>
  <configure name="DISTCHECK_CONFIG_FLAGS" value="'CFLAGS=-march=pentium4 -mtune=generic -O2 -pipe -fno-plt -fexceptions         -Wp,-D_FORTIFY_SOURCE=2 -Wformat -Werror=format-security         -fstack-clash-protection  -g -ffile-prefix-map=/build/imagemagick/src=/usr/src/debug -flto=auto' 'LDFLAGS=-Wl,-O1,--sort-common,--as-needed,-z,relro,-z,now -flto=auto'  --disable-deprecated  --with-quantum-depth=16  --with-jemalloc=no  --with-umem=no  --with-autotrace=no  --with-dps=no  --with-dejavu-font-dir=/usr/share/fonts/TTF  --with-fftw=no  --with-flif=no  --with-fpx=no  --with-gslib=no  --with-fontpath=  --with-gs-font-dir=/usr/share/fonts/gsfonts  --with-gvc=no "/>
  <configure name="DOCUMENTATION_PATH" value="/usr/share/doc/ImageMagick-7"/>
