  <configure name="LIBRARY_PATH" value="/usr/lib/ImageMagick-7.1.0"/>
  <configure name="LIBS" value=" -llcms2  -lfreetype  -lraqm  -llqr-1 -lglib-2.0   -lxml2   -lfontconfig -lfreetype  -lXext   -lSM -lICE -lX11  -lXt -lbz2 -lz  -lzip   -lltdl  -lm    -lpthread  -lgomp"/>
  <configure name="LIB_VERSION_NUMBER" value="7,1,0,45"/>
