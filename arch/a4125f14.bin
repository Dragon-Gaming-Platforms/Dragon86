prefix=/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: gd
Description: GD graphics library
Version: 2.3.3
Requires:
Requires.private:   zlib  libpng  freetype2 >= 9.8.3  fontconfig  libjpeg  xpm  libtiff-4  libwebp >= 0.2.0  libheif >= 1.7.0  libavif >= 0.8.2
Cflags: -I${includedir}
Libs.private:  
Libs: -L${libdir} -lgd
